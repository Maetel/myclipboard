{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyMemo Clipboard",
  "version": "0.2.0",
  "identifier": "my.memos.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "MyMemo Clipboard", "width": 820, "height": 760, "minWidth": 620, "minHeight": 600, "resizable": true },
      { "label": "clipboard-popup", "title": "클립보드 기록", "url": "popup.html", "width": 440, "height": 420, "visible": false, "resizable": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "focus": true }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
